<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="../../Migrations/Install.props" />
  <PropertyGroup>
    <PackageId>AurorisNet.Umbraco.AppBlocks</PackageId>
    <Title>AppBlocks</Title>
    <Description>Forms, schedules, API endpoints, and database-backed application blocks for Umbraco 18.</Description>
    <PackageTags>umbraco;forms;blocks;database</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="AppBlocks.Tests" />
    <InternalsVisibleTo Include="AppBlocks.InteractiveReports.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <!-- No database driver: Microsoft.Data.Sqlite and Microsoft.Data.SqlClient come with Umbraco.Cms, and a site installs
         Npgsql or Oracle.ManagedDataAccess.Core itself, which Connections/DatabaseDrivers.cs loads by name. -->
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/business-rules.md" Pack="true" PackagePath="docs/" />
    <!-- Keeps a site's C# folder out of its own compilation; the demo imports it directly, as a project reference brings no build files. -->
    <!-- NuGet imports a build file only when it is named after the package id. -->
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
    <EmbeddedResource Include="../../docs/business-rules.md" LogicalName="AppBlocks.BusinessRules.md" />
    <EmbeddedResource Include="Views/**/*.cshtml" />
    <!-- The shipped languages, one file per culture, read by AppBlocksTranslations; WithCulture keeps fr.json out of a satellite assembly. -->
    <Content Remove="Localisation/**" />
    <None Remove="Localisation/**" />
    <EmbeddedResource Include="Localisation/*.json" LogicalName="AppBlocks.Localisation.%(Filename)%(Extension)" WithCulture="false" />
    <Content Update="**/*.cshtml;appsettings-schema*.json;umbraco-package-schema.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <!-- Embedded above, so a site's project must not receive them as well. -->
    <Content Update="Schema/**/*.config;appsettings-schema*.json;umbraco-package-schema.json" Pack="false" />
    <EmbeddedResource Include="$(InstallRoot)AppBlocks/Schema/**/*.config" Link="Schema\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Migrations/Runtime/**/*.cs" />
    <_AppBlocksMigrationSql Include="../../Migrations/*/AppBlocks/**/*.sql" />
    <EmbeddedResource Include="@(_AppBlocksMigrationSql)" Link="Migrations\$([MSBuild]::MakeRelative('$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Migrations'))', '%(FullPath)'))" />
  </ItemGroup>
</Project>
