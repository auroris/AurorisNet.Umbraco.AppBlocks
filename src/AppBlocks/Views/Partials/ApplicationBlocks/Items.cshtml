@using AppBlocks.Blocks
@model AppBlockItems
@inject BlockConditions Conditions
@inject IVariationContextAccessor VariationContext
@*
    One grid of blocks: the page, or one area of a block. The Umbraco classes and custom properties
    are the ones umbraco-blockgridlayout.css computes columns from; ah-grid and ah-grid__item are the
    hooks each theme styles (gutters, and stacking below its breakpoint). The grid is as many columns
    wide as the area spans, as in the backoffice, so a span means the same in both places.

    A field's width replaces the span the backoffice gives it, and ah-grid__item--width-N names the
    width the editor chose. Raw HTML renders directly into the grid. Assets and hidden fields
    also run their partial without a grid item around them.
*@
@if (Model.Items.Any())
{
    <div class="ah-grid umb-block-grid__layout-container" data-grid-columns="@Model.Columns" style="--umb-block-grid--grid-columns: @Model.Columns;">
    @foreach (var item in Model.Items)
    {
        var view = new AppBlockView(Model.Page, item, Model.Form, Model.MemberId, Model.HeadingLevel, Model.Variables);
        var caller = view.Admitted ? Context.User : null;
        var culture = VariationContext.VariationContext?.Culture is { Length: > 0 } c && Model.Page.Cultures.ContainsKey(c) ? c : null;
        if (!(Model.Form?.Includes(item) ?? await Conditions.MatchesAsync(item, BlockConditions.Security, Model.Page, caller, culture, ct: Context.RequestAborted))) { continue; }
        var visible = Model.Form?.IsVisible(item) ?? await Conditions.MatchesAsync(item, BlockConditions.Visibility, Model.Page, caller, culture, ct: Context.RequestAborted);
        if (!AppBlockLayout.OccupiesCell(item))
        {
            if (visible) { @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Block.cshtml", view) }
            else { <div style="display: none;">@await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Block.cshtml", view)</div> }
            continue;
        }
        var span = AppBlockLayout.ItemSpan(item, Model.Columns);
        var width = AppBlockField.Width(item.Content) is { } chosen ? " ah-grid__item--width-" + chosen : "";
        <div class="ah-grid__item@(width)@(visible ? null : " app-block-invisible") umb-block-grid__layout-item" data-content-element-type-alias="@item.Content.ContentType.Alias"
            data-col-span="@span" data-row-span="@item.RowSpan"
            style="--umb-block-grid--item-column-span: @span; --umb-block-grid--item-row-span: @item.RowSpan;@(visible ? null : " display: none;")">
            @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Block.cshtml", view)
        </div>
    }
    </div>
}
