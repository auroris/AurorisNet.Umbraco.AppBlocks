<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AurorisNet.Umbraco.AppBlocks.Testing</PackageId>
    <Title>AppBlocks Testing</Title>
    <Description>HTTP test clients, Umbraco test helpers, and schema/content snapshot checks for AppBlocks sites. Depends on AurorisNet.Umbraco.AppBlocks.</Description>
    <PackageTags>umbraco;appblocks;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Migrations/Testing/*.cs" />
    <!-- FormsClient builds query strings with Microsoft.AspNetCore.WebUtilities. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The clients drive AppBlocks' endpoints, so the package carries the AppBlocks version they were written against. -->
    <ProjectReference Include="../AppBlocks/AppBlocks.csproj" />
    <InternalsVisibleTo Include="AppBlocks.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- Umbraco's build targets copy these into every project folder; they stay out of the package. -->
    <None Update="appsettings-schema*.json;umbraco-package-schema.json" Pack="false" />
  </ItemGroup>
</Project>
