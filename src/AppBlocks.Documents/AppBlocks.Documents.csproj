<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="../../Migrations/Install.props" />
  <PropertyGroup>
    <PackageId>AurorisNet.Umbraco.AppBlocks.Documents</PackageId>
    <Title>AppBlocks Documents for Umbraco</Title>
    <Description>Generate templated HTML and PDF documents from AppBlocks data sources. PDF conversion optionally uses Pressroom.</Description>
    <PackageTags>umbraco;appblocks;documents;pdf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../AppBlocks/AppBlocks.csproj" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageReference Include="AurorisNet.Pressroom.Client" Version="1.3.2" />
    <InternalsVisibleTo Include="AppBlocks.Documents.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Content Update="Schema/**/*.config;appsettings-schema*.json;umbraco-package-schema.json" Pack="false" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <EmbeddedResource Include="$(InstallRoot)AppBlocks.Documents/Schema/**/*.config" Link="Schema\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
